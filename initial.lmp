# Creating the initial liquid structure for a binary Zr_xCu_(1-x) alloy

#------------------------------- Random number generator --------------------------------#

  # Initializes random number generator

  variable      rnd equal round(random(0,999999,${RANDOM}))
 
#----------------------------------------------------------------------------------------#

#------------------------------ General variables ---------------------------------------#
 # Simulation variables

  variable                  T         equal     2000
  variable                  T0        equal     0.5*$T


 # Structural variables

  variable                  n         equal     7             # System size
  variable                  N         equal     10000         # Total atoms
  variable                  N_Cu      equal     0.50*$N       # Cu atoms
  variable                  N_Zr      equal     0.50*$N       # Zr atoms
 
  # Time variables

  variable                  t_eq      equal     50000         # Equlibration time
  variable                  dt        equal     0.001         # Time step
  variable                  damp_t    equal     200*${dt}     # Thermostat damping
  variable                  damp_p    equal     5000*${dt}    # Barostat damping

#----------------------------------------------------------------------------------------#

#------------------------------ Atomic setup  -------------------------------------------#

  units                 metal                                 #(time ps, energy eV, pressure Bars, Volume A^3)

  # Define geometry and create atoms.

  atom_style            atomic
  lattice               fcc     3.22096030
  region                sim_box block      -$n $n -$n $n -$n $n
  create_box            2       sim_box
  create_atoms          1       random     ${N_Zr}  ${rnd} NULL
  variable              rnd     equal      round(random(0,999999,0))      # Generates new rnd 
  create_atoms          2       random     ${N_Cu}  ${rnd} NULL
  variable              rnd     equal      round(random(0,999999,0))      # Generates new rnd 

  mass                  1       91.224                        # Zr atomic mass
  mass                  2       63.654                        # Cu atomic mass
   
  group                 Zr      type 1
  group                 Cu      type 2

  # Interatomic potential, this will be the part to change to include the ones generated by means of VAPS and ML frameworks 

  pair_style            eam/alloy
  pair_coeff            * * potentials/ZrCuAl.lammps.eam Zr Cu 
  timestep              ${dt}

#-------------------------- Equilibrating the liquid at p = 0 Bars, and T = 2000 K ---------#

#------------------------------------------ NpT ensemble -----------------------------------#

# Equilibration 1: Simple liquid

  thermo                 100                                  # printing properties every 100 steps
  min_style              sd                                   # minimizing via steppest descent
  minimize               0 0 500000 500000
  min_style              fire                                 # minimizing via FIRE
  minimize               0 0 500000 500000
  reset_timestep         0
  velocity               all     create     ${T0}      ${rnd}  mom    yes  rot  yes  dist  gaussian
  variable               rnd     equal      round(random(0,999999,0))    # Generates new rnd 
  reset_timestep         0
  thermo_style           custom  step temp etotal pe press vol 
  fix                    f1      all        npt temp   $T  $T  0.2  iso 0.0 0.0 5.0 fixedpoint 0.0 0.0 0.0
  run                    ${t_eq}
  unfix                  f1
  reset_timestep         0
  fix                    f1      all        npt temp   $T  $T  0.2  iso 0.0 0.0 5.0 fixedpoint 0.0 0.0 0.0
 # dump                   data    all        xyz     1000  Liquid_Zr50Cu50.xyz
 # dump_modify            data    element Zr Cu 
  run                    ${t_eq}
  write_data             Liquid_Zr50Cu50_2000K_0bars_10000_atoms.dat
  unfix                  f1
