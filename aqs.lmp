# CuZr glass N = 10000, p = 0, T = 0K

# Initial definitions

units           metal                                                    # time=ps,p=bars,E=eV,V=A^3
boundary        p p p                                                    # periodic boundary condition
atom_style      atomic                                                   # the systems have charge
variable        i                                 loop  2500             # Deformation up to 25%
variable        dt                                equal 0.001            # Timestep.
variable        damp_T                            equal 100*${dt}        # Thermostat damp parameter.
variable        damp_p                            equal 2500*${dt}       # Barostat damping
variable        epsilon                           equal 1e-4
variable        gamma                             equal 1e-4             # Deformation step
variable        dgamma                            equal ${gamma}/${dt}   # Initial deformation
read_data       ../Zr36Cu64_NVT_10_glass.dat                             # Glass obtained by cooling 100K/ns


# Interatomic interactions

pair_style      eam/alloy
pair_coeff      * * ../potentials/ZrCuAl.lammps.eam Zr Cu

thermo          100

# Simple shear xy direction up to gamma = 0.25

compute         peall        all   pe
compute         pe_per_atom  all   pe/atom
compute         S            all   stress/atom NULL
compute         pxy          all   reduce sum c_S[4]
variable        tau          equal c_pxy/vol
change_box      all          triclinic
variable        maxforce     equal abs(fmax)
thermo_style    custom       step temp press pe v_tau

min_style       fire
minimize        1e-15 1e-15 10000 10000
run             0
write_dump all custom Dumps/reference_state.dat id type xu yu zu c_pe_per_atom

# AQS Deformation

min_style       fire
label           aqs

# Stress and Strain

variable        strain_xy  equal   "xy/ly"
variable        SS_xy      equal   "-pxy/10000"

# Capture energy of the RELAXED state from the PREVIOUS step

variable pe_start equal $(c_peall)
variable tau_start equal ${tau}

# Apply Deformation (This raises the energy)

fix 1 all deform 1 xy erate ${dgamma} remap x units box
run 1
unfix 1

# Relax (This lowers the energy)

minimize 1e-12 1e-12 10000 10000

# Calculate Total Step Change

variable dE_step   equal (c_peall-${pe_start})/atoms
variable dtau_step equal (${tau}-${tau_start})
variable gamma_val equal (${i}*${epsilon})

print "${strain_xy} ${SS_xy} ${dE_step} ${dtau_step}" append avalanches.dat

# Avalanche detection
# Avalanches are usually characterized by a drop in stress (dtau_step < 0)
# and a specific energy signature.

if "${dE_step} < -5e-6" then &
   "write_dump all custom Dumps/avalanche_${gamma_val}.dat id type xu yu zu c_pe_per_atom"

    next i
    jump SELF aqs
